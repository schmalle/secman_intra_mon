# secman_intra_mon configuration — copy to .env and fill in, then:
#   set -a; . ./.env; set +a
# Credentials are read from the environment only, never from CLI arguments.
# Values may be pass:// references resolved via pass-cli wrapper scripts
# (same convention as the other secman extensions).

# --- Local MariaDB (persistence for discover/scan/assets/networks/runs) ---
SECMAN_INTRA_MON_DB_HOST=127.0.0.1
SECMAN_INTRA_MON_DB_PORT=3306
SECMAN_INTRA_MON_DB_NAME=secman_intra_mon
SECMAN_INTRA_MON_DB_USER=intra_mon
SECMAN_INTRA_MON_DB_PASSWORD=CHANGEME
# SECMAN_INTRA_MON_DB_PASSWORD=pass://secman/intra-mon-db-password

# --- secman backend (optional, for --upload-secman / secman-push) ---
# https required; plain http is only accepted for localhost development.
# The account needs the ADMIN role (asset import + nmap upload are ADMIN endpoints);
# use a dedicated service account.
SECMAN_URL=http://localhost:8080
SECMAN_USERNAME=intra-mon-service
SECMAN_PASSWORD=CHANGEME
# SECMAN_PASSWORD=pass://secman/intra-mon-service-password
# Alternative to username/password: reuse an existing JWT (8h lifetime)
# SECMAN_TOKEN=
# Owner written onto imported assets (default: SECMAN_USERNAME)
# SECMAN_ASSET_OWNER="Security Team"

# --- LLM features (optional: report, enrich, ask, discover --agentic) ---
# OpenRouter API key (https://openrouter.ai). Without it all LLM features are
# disabled and everything else works unchanged. Note: scan data sent to the
# endpoint is a map of your internal network — see docs/SAFETY.md (data egress).
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEY=pass://secman/openrouter-api-key
# Model for reports / classification / NL2SQL (any OpenRouter model id)
# SECMAN_INTRA_MON_LLM_MODEL=openai/gpt-4o-mini
# Stronger model for the agentic planner (default: same as MODEL)
# SECMAN_INTRA_MON_LLM_PLANNER_MODEL=
# OpenAI-compatible endpoint — point to a self-hosted gateway to keep scan
# data on-prem (https required; plain http only for localhost)
# SECMAN_INTRA_MON_LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM request timeout in seconds
# SECMAN_INTRA_MON_LLM_TIMEOUT=60
